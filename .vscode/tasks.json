{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "compile and run",
            "type": "shell",
            "command": "clang++ -std=c++17 -g -I $HOME/.cpp-includes -o '${fileBasenameNoExtension}' '${file}' && ./'${fileBasenameNoExtension}' < input.txt > output.txt",
            "options": {
                "cwd": "${fileDirname}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "clear": true
            }
        }
    ]
}